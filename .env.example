# =============================================================================
# CMS Core Starter Kit — example configuration
#
# `cp .env.example .env` for local development. In a container deployment there is no
# .env file: every value below is set as a container environment variable instead.
#
# The defaults here are the ones the application genuinely runs on. Anything that needs
# an extra service is commented out and marked OPTIONAL, so nothing in this file
# obliges you to run infrastructure you do not have.
# =============================================================================

APP_NAME="CMS Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Persian-first. All three locales are structural from day one (Requirements 5.1, 5.2).
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
#
# SQLite for local development, MySQL in production. That split is not a preference:
# per-locale slug uniqueness (Decision D-1) is enforced by MySQL stored generated
# columns with unique indexes, which SQLite cannot express. Locally an application-level
# check covers it, and the tests that prove the database-level guarantee skip.
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite

# Production:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cms_core
# DB_USERNAME=cms
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions, cache and queue
#
# All three default to the database, so the application needs no service beyond MySQL.
#
# A QUEUE WORKER IS STILL REQUIRED. Image conversions, search indexing, sitemap
# regeneration and video metadata extraction are queued regardless of the driver.
# Without a worker running, uploads succeed and thumbnails are never generated — with no
# error anywhere. See docs/coolify.md.
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# OPTIONAL — Redis. Faster, and the only store that supports cache tags, which lets the
# Delivery API invalidate by tag instead of flushing the whole cache on a publish.
# Everything works without it; this is a performance choice, not a requirement.
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Filesystem — RULE #9: local disk only.
#
# There is deliberately no S3/MinIO/cloud driver in config/filesystems.php, no AWS_* keys
# here, and CmsServiceProvider prunes cloud disks from the resolved config at boot. An
# architecture test fails the build if a cloud adapter appears in composer.json.
#
# In a container this means the media directory MUST be on a persistent volume, or every
# upload is destroyed on redeploy.
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Search
#
# `collection` runs the search feature against the database with no extra service. It
# works; it has no typo tolerance or relevance ranking, and it slows down as content
# grows.
#
# OPTIONAL — Meilisearch, self-hosted (blueprint §5). Switching is two variables and no
# code change. One index per locale: contents_fa, contents_en, contents_ar.
# Build them with: php artisan scout:import "App\Models\Content"
# -----------------------------------------------------------------------------
SCOUT_DRIVER=collection
SCOUT_QUEUE=true

# SCOUT_DRIVER=meilisearch
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=

# -----------------------------------------------------------------------------
# Mail
#
# `log` writes mail into the log instead of sending it. Set a real mailer before relying
# on password resets.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls

# -----------------------------------------------------------------------------
# CMS
# -----------------------------------------------------------------------------
# Base URL of the public frontend when it is a separate deployment — the normal case for
# this headless Core. Empty falls back to APP_URL. Canonical URLs, hreflang annotations
# and every sitemap entry are built from it, so a wrong value submits a sitemap full of
# the wrong hostname to Search Console.
CMS_FRONTEND_URL=

# Optional. Serves media from the FRONTEND's origin instead of this host, so images are
# same-host as the pages embedding them and the frontend's CDN caches them. Requires a
# rewrite on the frontend from this path back to /storage here — see docs/deployment.md.
# Leave unset to serve media from this host (robots.txt then keeps /storage crawlable).
# CMS_MEDIA_URL=https://www.example.com/media

CMS_SOURCE_LOCALE=fa

# The timezone dates are DISPLAYED in, and that the admin's date pickers read and write.
# Storage stays UTC (APP_TIMEZONE) — this is presentation only.
#
# It is not cosmetic for Iran: the offset is +03:30, so anything published after 20:30 UTC
# already belongs to the next Persian day, and a time an editor types as 09:00 must be
# stored as 05:30. See docs/dates.md.
CMS_DISPLAY_TIMEZONE=Asia/Tehran

CMS_PANEL_PATH=admin
CMS_BRAND_PRIMARY="#0F766E"
CMS_SLIDES_MAX=5
CMS_PREVIEW_TTL=60
CMS_VERSIONS_KEEP=20

# Decision D-9: the Delivery API is public by default. If you enable the key, the
# application fails closed when the key is blank rather than serving unprotected.
CMS_DELIVERY_REQUIRE_KEY=false
CMS_DELIVERY_API_KEY=
CMS_DELIVERY_RATE_LIMIT=120
CMS_DELIVERY_CACHE_TTL=300
CMS_MANAGEMENT_RATE_LIMIT=60

# Redirect lookups (GET /api/v1/redirects/resolve) get their own, much higher allowance.
# The frontend calls it on every 404 IT serves, from one server IP for the whole site's
# traffic — so under the shared read limit a crawler walking a few stale URLs would
# throttle every real visitor, and the thing that breaks is redirect handling. Each call
# is an in-memory lookup against one cached map. See docs/redirects.md.
CMS_REDIRECT_RATE_LIMIT=600

# Decision D-6. Present in the Docker image. Without it, a video's duration and
# dimensions have to be entered by hand in the panel — a supported, tested path, not a
# broken one.
CMS_FFPROBE_PATH=ffprobe

# Trust the reverse proxy's X-Forwarded-* headers. The default of '*' is correct when the
# application is only reachable THROUGH a proxy, which is the case for any container
# deployment. Narrow it to the proxy's address if the container is also directly
# reachable, because a client that can connect to the app itself could otherwise spoof
# its own IP and evade the rate limiters.
TRUSTED_PROXIES=*

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Container deployment only
#
# These are read by the Docker image's entrypoint, not by Laravel, so they do nothing
# locally. Listed here because this file is the canonical reference for configuration.
# See docs/coolify.md.
# =============================================================================
# Run storage:link and warm the config/route/view caches at container start, and apply
# migrations. Migrations at startup are correct for a single-container deployment; turn
# the migration half off if a separate process owns the schema.
# AUTORUN_ENABLED=true
# AUTORUN_LARAVEL_MIGRATION=true
#
# Raised from the image's 256M default: Media Library decodes an upload into a bitmap to
# build the thumbnail and WebP variants, and a large photograph exhausts 256M.
# PHP_MEMORY_LIMIT=512M
#
# A form with many translatable fields across three locales exceeds the 1000 default.
# PHP_MAX_INPUT_VARS=5000
#
# Set to 0 only if you deliberately serve the panel over plain HTTP. Otherwise login
# appears to succeed and returns to the form, because the browser discards the cookie.
# PHP_SESSION_COOKIE_SECURE=1
