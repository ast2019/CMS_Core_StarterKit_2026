APP_NAME="CMS Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Persian-first. All three locales are structural from day one (Req 5.1, 5.2).
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Database — MySQL in production, SQLite for local dev only (Req 2.1, 2.2).
# Per-locale slug uniqueness relies on MySQL generated columns (Decision D-1),
# which SQLite cannot represent; locally an application-level rule covers it.
# ----------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cms_core
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# ----------------------------------------------------------------------------
# Filesystem — RULE #9: local disk only. There is deliberately no S3/MinIO/
# cloud driver in config/filesystems.php, and no AWS_* keys here. Adding them
# back is a defect, and tests/Architecture asserts their absence.
# ----------------------------------------------------------------------------
FILESYSTEM_DISK=local

# Cache and queue degrade to database locally; Redis in production (Req 1.3).
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Search — self-hosted Meilisearch (Req 6.1-6.5). Locally the `collection`
# driver keeps the test suite runnable with no search service present.
# ----------------------------------------------------------------------------
SCOUT_DRIVER=collection
# SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ----------------------------------------------------------------------------
# CMS
# ----------------------------------------------------------------------------
CMS_SOURCE_LOCALE=fa
CMS_PANEL_PATH=admin
CMS_BRAND_PRIMARY="#0F766E"
CMS_SLIDES_MAX=5
CMS_PREVIEW_TTL=60
CMS_VERSIONS_KEEP=20

# Decision D-9: Delivery API is public by default; the key infrastructure
# exists so a site can lock it down without re-engineering.
CMS_DELIVERY_REQUIRE_KEY=false
CMS_DELIVERY_API_KEY=
CMS_DELIVERY_RATE_LIMIT=120
CMS_DELIVERY_CACHE_TTL=300
CMS_MANAGEMENT_RATE_LIMIT=60

# Decision D-6: needed only to derive a thumbnail from a locally uploaded
# video. Without it the panel requires a thumbnail to be uploaded manually.
CMS_FFPROBE_PATH=ffprobe

VITE_APP_NAME="${APP_NAME}"
